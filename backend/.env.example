# Database Configuration
# For Azure Production - Azure Database for MySQL:
# DATABASE_URL=mysql+pymysql://username:password@smartfinance-db.mysql.database.azure.com:3306/smartfinance_db

# For other cloud providers (AWS RDS, Supabase, Railway):
# DATABASE_URL=mysql+pymysql://username:password@host:3306/database_name

# For development with SQLite (no MySQL server needed):
DATABASE_URL=sqlite:///./smartfinance.db

# Security
# Generate a strong random key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-production-use-random-string

# Groq API for LLM Chatbot
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Frontend URL
# Update to your production domain (e.g., https://yourapp.com)
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
